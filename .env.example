# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_SMART=deepseek-v4-pro

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Firecrawl
FIRECRAWL_API_KEY=
# Page reader. Set both to read pages with Crawl4AI first (free). Firecrawl is used only if Crawl4AI fails.
# Leave empty to use Firecrawl for everything.
CRAWL4AI_URL=
CRAWL4AI_TOKEN=
CRAWL4AI_CONCURRENCY=3

# Wait time between Firecrawl requests (seconds), requests at once, and retries after a 429 "too many requests".
# Free plans are strict: use 6 / 1. Paid plans can go faster: 0.5 / 5.
FIRECRAWL_MIN_INTERVAL=2
FIRECRAWL_CONCURRENCY=2
FIRECRAWL_MAX_RETRIES=6

# App
APP_SECRET_KEY=
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=
DRY_RUN=true
DEV_FIRECRAWL_CREDIT_LIMIT=150
DEV_LLM_CALL_LIMIT=100

# Hosting (leave empty for local use)
# Password for the whole app. SET THIS before the API is reachable from the internet.
ACCESS_PASSWORD=

# Optional
COMPANIES_HOUSE_API_KEY=
